# Copy to .env. docker compose passes this file to both containers (env_file)
# and reads it for the Traefik labels, so these settings live here and nowhere
# else.
#
# Fill in every value: blank ones make the server or the database fail at
# startup (the logs name the setting). The comments say how to get each one.

# --- This server ------------------------------------------------------------
# Public hostname for this tunnel server; tunnels are <id>.tunnel.example.com.
# DNS: both tunnel.example.com and the wildcard *.tunnel.example.com must point
# at this host.
OPENTUNNEL_DOMAIN=tunnel.example.com

# --- Certificates -----------------------------------------------------------
# One certificate per tunnel, ordered through ACME with DNS-01 challenges.
# ZeroSSL is the default because the server requires external account binding:
# create a free account, then Developer -> EAB Credentials in its dashboard.
ACME_EMAIL=you@example.com
ACME_EAB_KID=
ACME_EAB_HMAC_KEY=
# A P-256 private JWK that names the ACME account. Generate it once, after the
# image is built, and never change it (a new key is a new account):
#   docker compose run --rm --no-deps opentunnel account-key
ACME_ACCOUNT_KEY_JWK=
# Another EAB-capable CA instead of ZeroSSL, e.g. Google Trust Services:
# ACME_URL=https://dv.acme-v02.api.pki.goog/directory

# Cloudflare: a token allowed to edit DNS in the zone (Zone -> DNS -> Edit),
# then the zone id. Generate and look them up with:
#   export CLOUDFLARE_API_TOKEN=...
#   curl -fsS -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
#     'https://api.cloudflare.com/client/v4/zones?name=example.com' | jq -r '.result[0].id'
# The TXT records go under <id>.tunnel.example.com, so this is the parent zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Database ---------------------------------------------------------------
# Used by MySQL and by the server's DATABASE_URL. Generate two different ones:
#   openssl rand -hex 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Enables POST /api/admin/{stats,export,import}. Generate with:
#   openssl rand -hex 32
# ADMIN_TOKEN=
# Ceiling on new tunnels per hour, per client address. The server defaults to
# 30/h with a burst of 10. The Traefik stack sets a global 300 in its compose
# file instead, because every request then arrives from Traefik's address.
# CREATE_RATE_PER_HOUR=300
# CREATE_RATE_BURST=30
