# Public origin used in androidipcamera:// pairing links. This must be the
# address the phone can reach, for example https://relay.example.com.
PUBLIC_URL=https://relay.example.com

# Where device records and pairing codes are stored. Media is never written.
DB_PATH=/storage/relay.sqlite

# Comma-separated STUN/TURN URLs. A TURN URL may embed credentials:
#   turn:user:password@turn.example.com:3478?transport=udp
# Credentials in the URL are split out before werift and the browser see it.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Optional dedicated TURN URL + credentials, added alongside the URLs above.
# Prefer this form when the password contains commas or @ characters.
# WEBRTC_TURN_URL=turn:turn.example.com:3478?transport=udp
# WEBRTC_TURN_USERNAME=user
# WEBRTC_TURN_CREDENTIAL=password

# Must match the published Docker UDP range and have min < max.
WEBRTC_UDP_PORT_RANGE=40000-40100

# Address that viewers should use for the WebRTC UDP candidates. Docker only
# sees the container interface, so without this the answer advertises an
# address such as 172.20.0.20 that a browser on your LAN cannot reach. Set it
# to the relay host's LAN/public IP whenever those differ from the container
# (for example 192.168.1.10). When unset, the relay uses the address that
# PUBLIC_URL resolves to if it is a private IPv4 address.
# WEBRTC_ADVERTISE_HOST=192.168.1.10

# Force relay-only ICE when every viewer must use TURN. The browser receives
# the same ICE servers and policy from /api/status.
WEBRTC_FORCE_TURN=false

# Maximum size of one recording buffered in relay memory for WebRTC playback.
# Increase only if relay memory can accommodate the larger recording.
WEBRTC_RECORDING_MAX_BYTES=536870912

# Keep recently downloaded recordings in memory so seeking does not refetch
# them from the camera. Defaults to WEBRTC_RECORDING_MAX_BYTES.
# WEBRTC_RECORDING_CACHE_BYTES=536870912
